# ============================================================
# TRACE-X FORENSIC INTELLIGENCE PLATFORM CONFIGURATION
# ============================================================

# Supabase PostgreSQL Settings
# Get these from your Supabase Project Settings -> Database / API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Elliptic Dataset Directory
# Provide local path where elliptic_txs_*.csv files are stored
DATASET_PATH=data/elliptic_bitcoin_dataset

# Optional Admin API Key for mutating training/ingestion endpoints
# Leave empty during local hackathon development; set in hosted environments
# ADMIN_API_KEY=your_strong_admin_secret

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ML Model Settings
MODEL_CACHE_DIR=models
ACTIVE_MODEL=gradient_boosting
